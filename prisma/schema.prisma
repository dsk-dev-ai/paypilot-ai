generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Identity ───────────────────────────────────────────────────────────

model User {
  id            String                    @id
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  preferences   Json?
  mandates      Mandate[]
  plans         ShoppingPlan[]
  orders        Order[]
  handoffs      ExternalCheckoutHandoff[]
  notifications Notification[]
  auditEvents   AuditEvent[]
  wishlistItems WishlistItem[]
  consents      PurchaseConsent[]
}

// ── Provider integration status (persisted verification history) ──────

enum IntegrationStateValue {
  VERIFIED
  CONFIGURED
  NOT_CONFIGURED
  ACCESS_PENDING
  ERROR
}

model ProviderStatusRecord {
  id             String                @id @default(cuid())
  provider       String                @unique
  state          IntegrationStateValue
  message        String
  lastCheckedAt  DateTime?
  lastVerifiedAt DateTime?
  lastError      Json?
  updatedAt      DateTime              @updatedAt
}

// ── Product listings (normalized snapshots from real provider calls) ──

model ListingRecord {
  id                 String         @id @default(cuid())
  provider           String
  externalId         String
  region             String
  title              String
  canonicalUrl       String
  imageUrl           String?
  priceMinor         BigInt
  currency           String
  originalPriceMinor BigInt?
  availability       String
  seller             String?
  brand              String?
  category           String?
  ratingValue        Float?
  ratingCount        Int?
  attributes         Json           @default("{}")
  attribution        String?
  fetchedAt          DateTime
  createdAt          DateTime       @default(now())
  planItems          PlanItem[]
  orderItems         OrderItem[]
  wishlistItems      WishlistItem[]

  @@unique([provider, externalId, region])
  @@index([category, currency])
}

// ── Purchase Mandate ───────────────────────────────────────────────────

model Mandate {
  id                   String         @id @default(cuid())
  userId               String
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                 String
  active               Boolean        @default(true)
  budgetMinor          BigInt
  currency             String
  minUnspentMinor      BigInt         @default(0)
  preferredBrands      String[]
  excludedBrands       String[]
  requiredAttributes   Json?
  maxQuantityPerItem   Int            @default(5)
  maxTotalItems        Int            @default(20)
  allowedProviders     String[]
  excludedProviders    String[]
  allowedDestinations  String[]
  maxListingAgeMinutes Int            @default(1440)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  plans                ShoppingPlan[]

  @@index([userId, active])
}

// ── Unified PayPilot shopping plan (the PayPilot cart) ─────────────────

enum PlanStatus {
  DRAFT
  APPROVED
  CHECKOUT_IN_PROGRESS
  CHECKED_OUT
  CANCELED
}

model ShoppingPlan {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String     @default("My Plan")
  status    PlanStatus @default(DRAFT)
  currency  String
  mandateId String?
  mandate   Mandate?   @relation(fields: [mandateId], references: [id], onDelete: SetNull)
  items     PlanItem[]
  consents  PurchaseConsent[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId, status])
}

// ── Per-purchase consent artifact (the Cart Mandate) ───────────────────

model PurchaseConsent {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId        String
  plan          ShoppingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  mandateId     String?
  currency      String
  subtotalMinor BigInt
  itemCount     Int
  decision      String       @default("ALLOW")
  snapshot      Json
  contentHash   String       @unique
  approvedAt    DateTime     @default(now())
  expiresAt     DateTime
  consumedAt    DateTime?
  revokedAt     DateTime?

  @@index([userId, approvedAt])
  @@index([planId])
}

model PlanItem {
  id                 String        @id @default(cuid())
  planId             String
  plan               ShoppingPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  listingId          String
  listing            ListingRecord @relation(fields: [listingId], references: [id])
  quantity           Int           @default(1)
  approvedPriceMinor BigInt?
  approvedAt         DateTime?
  addedAt            DateTime      @default(now())

  @@unique([planId, listingId])
}

// ── Orders, payments, external handoffs ────────────────────────────────

enum OrderStateValue {
  CREATED
  PENDING_APPROVAL
  APPROVED
  CAPTURING
  PAID
  FAILED
  CANCELED
  REFUNDED
}

model Order {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId            String?
  state             OrderStateValue  @default(CREATED)
  currency          String
  subtotalMinor     BigInt
  shippingMinor     BigInt?
  taxMinor          BigInt?
  totalMinor        BigInt
  amountIsEstimate  Boolean          @default(true)
  paymentProvider   String?
  providerReference String?          @unique
  environment       String           @default("sandbox")
  idempotencyKey    String?          @unique
  consentId         String?
  consentHash       String?
  items             OrderItem[]
  paymentAttempts   PaymentAttempt[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([userId, state])
  @@index([consentId])
}

model OrderItem {
  id             String         @id @default(cuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listingId      String?
  listing        ListingRecord? @relation(fields: [listingId], references: [id])
  title          String
  provider       String
  externalId     String
  canonicalUrl   String
  quantity       Int
  unitPriceMinor BigInt
  currency       String
}

model PaymentAttempt {
  id                String    @id @default(cuid())
  orderId           String
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String
  status            String
  amountMinor       BigInt
  currency          String
  providerReference String?
  failureCode       String?
  failureMessage    String?
  createdAt         DateTime  @default(now())
  verifiedAt        DateTime?

  @@index([orderId])
}

model ExternalCheckoutHandoff {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   String
  url        String
  listingId  String?
  planItemId String?
  orderId    String?
  state      String   @default("OPENED")
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

// ── Audit & notifications ──────────────────────────────────────────────

model AuditEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

// ── Append-only, hash-chained ledger (the verifiable audit trail) ─────

model LedgerEntry {
  id        String   @id @default(cuid())
  seq       Int      @unique
  type      String
  userId    String?
  subjectId String?
  detail    Json?
  prevHash  String
  hash      String   @unique
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([subjectId])
  @@index([type])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model WishlistItem {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   ListingRecord @relation(fields: [listingId], references: [id], onDelete: Cascade)
  note      String?
  addedAt   DateTime      @default(now())

  @@unique([userId, listingId])
  @@index([userId, addedAt])
}
